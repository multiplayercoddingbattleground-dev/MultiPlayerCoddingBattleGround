PORT=5000
MONGO_URI=mongodb://localhost:27017/coding-battle
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Code execution: "stub" always reports success without running anything.
# "local" actually runs code on this machine (javascript/cpp only — no
# sandboxing, fine for solo local dev). "remote" runs code via Judge0 CE
# (hosted on RapidAPI, needs a CODE_EXEC_API_KEY).
CODE_EXEC_PROVIDER=stub
CODE_EXEC_API_URL=
CODE_EXEC_API_KEY=
CODE_EXEC_TIMEOUT_MS=5000
